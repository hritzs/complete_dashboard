func (s *Service) executeBuild(ctx context.Context, executor Executor, trade StoredTrade, chunks [][]ExecOrder) error {
	sellBuffer := trade.Config.SellBuffer
	if sellBuffer <= 0 {
		sellBuffer = 2.0
	}

	for chunkIdx, chunk := range chunks {
		ordersToProcess := append([]ExecOrder(nil), chunk...)
		maxChunkRetries := 3

		for retryIter := 0; retryIter < maxChunkRetries && len(ordersToProcess) > 0; retryIter++ {
			if retryIter > 0 {
				time.Sleep(1 * time.Second)
			}

			var nextRetry []ExecOrder

			for i := range ordersToProcess {
				order := ordersToProcess[i]

				bufferMultiplier := float64(retryIter + 1)
				limit := math.Max(0.05, order.ExpectedPrice-sellBuffer*bufferMultiplier)
				order.LimitPrice = math.Round(limit/0.05) * 0.05

				intent := OrderIntent{
					IntentID:      order.UID,
					TradeUID:      trade.TradeUID,
					Token:         order.Token,
					Side:          order.Action,
					Quantity:      int64(order.Quantity),
					OrderType:     "LIMIT",
					ProductType:   trade.ProductType,
					LegType:       order.OptionType,
					Phase:         "BUILD",
					OrderUID:      order.UID,
					BrokerName:    trade.BrokerName,
					AccountID:     trade.AccountID,
					ExpectedPrice: order.ExpectedPrice,
				}
				lp := order.LimitPrice
				intent.LimitPrice = &lp

				s.Store.AppendIntent(trade.TradeUID, intent)

				res, err := executor.ExecuteOrderIntent(ctx, intent)
				if err != nil {
					log.Printf("❌ BUILD chunk=%d retry=%d leg=%s err=%v", chunkIdx+1, retryIter+1, order.OptionType, err)
					nextRetry = append(nextRetry, order)
					continue
				}

				if res.Status != "FILLED" && res.Status != "SUCCESS" && res.Status != "ACKED" {
					nextRetry = append(nextRetry, order)
				}
			}

			ordersToProcess = nextRetry
		}

		if len(ordersToProcess) > 0 {
			return fmt.Errorf("build chunk %d failed after retries", chunkIdx+1)
		}
	}

	return nil
}

func (s *Service) startRuntime(trade StoredTrade) {
	if _, ok := s.Store.LoadRuntime(trade.TradeUID); ok {
		return
	}

	rt := &RuntimeTrade{
		Trade:  trade,
		StopCh: make(chan struct{}),
		DoneCh: make(chan struct{}),
	}
	s.Store.SaveRuntime(rt)

	go func() {
		defer close(rt.DoneCh)
		ticker := time.NewTicker(time.Duration(maxInt(1, trade.Config.PollIntervalSec)) * time.Second)
		defer ticker.Stop()

		for {
			select {
			case <-rt.StopCh:
				return
			case <-ticker.C:
				s.runMonitorCycle(trade.TradeUID)
			}
		}
	}()
}

func (s *Service) runMonitorCycle(tradeUID string) {
	trade, ok := s.Store.LoadTrade(tradeUID)
	if !ok {
		return
	}
	if trade.Status == "CLOSED" || trade.Status == "FAILED" {
		return
	}

	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()

	chain, err := s.Snapshot.GetOptionChain(ctx, trade.Symbol, trade.Expiry)
	if err != nil {
		log.Printf("⚠ snapshot fetch failed for %s: %v", tradeUID, err)
		return
	}

	var ceRow, peRow *OptionChainRow
	for i := range chain.Chain {
		row := &chain.Chain[i]
		if row.CEToken == trade.CEToken {
			ceRow = row
		}
		if row.PEToken == trade.PEToken {
			peRow = row
		}
	}
	if ceRow == nil || peRow == nil {
		return
	}

	cePNL := (trade.CELtp - ceRow.CELtp) * float64(trade.CEQty)
	pePNL := (trade.PELtp - peRow.PELtp) * float64(trade.PEQty)
	totalPNL := cePNL + pePNL

	netDelta := ceRow.CEDelta*float64(trade.CEQty) + peRow.PEDelta*float64(trade.PEQty)
	netGamma := ceRow.CEGamma*float64(trade.CEQty) + peRow.PEGamma*float64(trade.PEQty)
	netTheta := ceRow.CETheta*float64(trade.CEQty) + peRow.PETheta*float64(trade.PEQty)
	netVega := ceRow.CEVega*float64(trade.CEQty) + peRow.PEVega*float64(trade.PEQty)

	snapshot := TradeSnapshot{
		TradeUID:      trade.TradeUID,
		Timestamp:     time.Now(),
		Status:        trade.Status,
		Symbol:        trade.Symbol,
		Expiry:        trade.Expiry,
		Strike:        trade.Strike,
		Underlying:    chooseUnderlying(*chain),
		TotalPNL:      totalPNL,
		RealizedPNL:   0,
		UnrealizedPNL: totalPNL,
		NetDelta:      netDelta,
		NetGamma:      netGamma,
		NetTheta:      netTheta,
		NetVega:       netVega,
		LivePositions: []TradeLegSnapshot{
			{
				Token:      trade.CEToken,
				Strike:     ceRow.Strike,
				OptionType: "CE",
				Action:     "SELL",
				Quantity:   int64(trade.CEQty),
				EntryPrice: trade.CELtp,
				LTP:        ceRow.CELtp,
				PNL:        cePNL,
				IV:         ceRow.CEIV,
				Delta:      ceRow.CEDelta,
				Gamma:      ceRow.CEGamma,
				Theta:      ceRow.CETheta,
				Vega:       ceRow.CEVega,
			},
			{
				Token:      trade.PEToken,
				Strike:     peRow.Strike,
				OptionType: "PE",
				Action:     "SELL",
				Quantity:   int64(trade.PEQty),
				EntryPrice: trade.PELtp,
				LTP:        peRow.PELtp,
				PNL:        pePNL,
				IV:         peRow.PEIV,
				Delta:      peRow.PEDelta,
				Gamma:      peRow.PEGamma,
				Theta:      peRow.PETheta,
				Vega:       peRow.PEVega,
			},
		},
	}

	s.Store.SaveSnapshot(snapshot)

	if trade.Config.SLPointsPerLot > 0 {
		totalLotsOpen := float64(trade.CEQty+trade.PEQty) / (2.0 * float64(maxInt(1, trade.LotSize)))
		slThreshold := -trade.Config.SLPointsPerLot * totalLotsOpen
		if totalPNL <= slThreshold {
			trade.Status = "CLOSED_SL"
			trade.LastUpdateTime = time.Now()
			s.Store.UpdateTrade(trade)
			if rt, ok := s.Store.LoadRuntime(tradeUID); ok {
				close(rt.StopCh)
				s.Store.DeleteRuntime(tradeUID)
			}
		}
	}
}

func (s *Service) SquareOff(tradeUID string, reason string) error {
	tr, ok := s.Store.LoadTrade(tradeUID)
	if !ok {
		return fmt.Errorf("trade not found")
	}
	tr.Status = "CLOSED"
	tr.LastUpdateTime = time.Now()
	s.Store.UpdateTrade(tr)

	if rt, ok := s.Store.LoadRuntime(tradeUID); ok {
		close(rt.StopCh)
		s.Store.DeleteRuntime(tradeUID)
	}
	return nil
}

func (s *Service) PartialSquareOff(tradeUID string, percentage float64) error {
	tr, ok := s.Store.LoadTrade(tradeUID)
	if !ok {
		return fmt.Errorf("trade not found")
	}
	if percentage <= 0 || percentage > 100 {
		return fmt.Errorf("invalid percentage")
	}

	scale := (100.0 - percentage) / 100.0
	tr.CEQty = int(math.Round(float64(tr.CEQty) * scale))
	tr.PEQty = int(math.Round(float64(tr.PEQty) * scale))
	tr.LastUpdateTime = time.Now()
	tr.Status = "PARTIAL"
	s.Store.UpdateTrade(tr)
	return nil
}

func (s *Service) ManualHedge(ctx context.Context, tradeUID string) error {
	tr, ok := s.Store.LoadTrade(tradeUID)
	if !ok {
		return fmt.Errorf("trade not found")
	}
	snap, ok := s.Store.LoadSnapshot(tradeUID)
	if !ok {
		return fmt.Errorf("snapshot not found")
	}
	if math.Abs(snap.NetDelta) < 1 {
		return nil
	}

	executor, err := s.BrokerFactory.GetExecutor(tr.UserID, tr.BrokerName, tr.AccountID)
	if err != nil {
		return err
	}

	chain, err := s.Snapshot.GetOptionChain(ctx, tr.Symbol, tr.Expiry)
	if err != nil {
		return err
	}
	atmRow, err := FindATMRow(*chain)
	if err != nil {
		return err
	}

	qty := tr.LotSize
	if qty <= 0 {
		qty = GetFallbackLotSize(tr.Symbol)
	}

	var ceSide, peSide string
	if snap.NetDelta < 0 {
		ceSide = "BUY"
		peSide = "SELL"
	} else {
		ceSide = "SELL"
		peSide = "BUY"
	}

	ceIntent := OrderIntent{
		IntentID:      BuildShortOrderUID(tr.Symbol, "HCE", time.Now(), 0),
		TradeUID:      tradeUID,
		Token:         atmRow.CEToken,
		Side:          ceSide,
		Quantity:      int64(qty),
		OrderType:     "LIMIT",
		ProductType:   tr.ProductType,
		LegType:       "CE",
		Phase:         "HEDGE",
		OrderUID:      BuildShortOrderUID(tr.Symbol, "HCE", time.Now(), 1),
		BrokerName:    tr.BrokerName,
		AccountID:     tr.AccountID,
		ExpectedPrice: atmRow.CELtp,
	}
	peIntent := OrderIntent{
		IntentID:      BuildShortOrderUID(tr.Symbol, "HPE", time.Now(), 0),
		TradeUID:      tradeUID,
		Token:         atmRow.PEToken,
		Side:          peSide,
		Quantity:      int64(qty),
		OrderType:     "LIMIT",
		ProductType:   tr.ProductType,
		LegType:       "PE",
		Phase:         "HEDGE",
		OrderUID:      BuildShortOrderUID(tr.Symbol, "HPE", time.Now(), 1),
		BrokerName:    tr.BrokerName,
		AccountID:     tr.AccountID,
		ExpectedPrice: atmRow.PELtp,
	}

	ceLimit := math.Max(0.05, atmRow.CELtp-2.0)
	peLimit := math.Max(0.05, atmRow.PELtp-2.0)
	ceIntent.LimitPrice = &ceLimit
	peIntent.LimitPrice = &peLimit

	s.Store.AppendIntent(tradeUID, ceIntent)
	s.Store.AppendIntent(tradeUID, peIntent)

	if _, err := executor.ExecuteOrderIntent(ctx, ceIntent); err != nil {
		return fmt.Errorf("hedge CE failed: %w", err)
	}
	if _, err := executor.ExecuteOrderIntent(ctx, peIntent); err != nil {
		return fmt.Errorf("hedge PE failed: %w", err)
	}

	return nil
}

func chooseUnderlying(chain OptionChainSnapshot) float64 {
	if chain.SyntheticSpot != 0 {
		return chain.SyntheticSpot
	}
	if chain.SyntheticFuture != 0 {
		return chain.SyntheticFuture
	}
	if chain.FutureLtp != 0 {
		return chain.FutureLtp
	}
	return 0
}

