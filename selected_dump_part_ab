	if strings.TrimSpace(orderUID) == "" {
		orderUID = intent.IntentID
	}

	orderType := intent.OrderType
	if strings.TrimSpace(orderType) == "" {
		orderType = "MARKET"
	}

	productType := intent.ProductType
	if strings.TrimSpace(productType) == "" {
