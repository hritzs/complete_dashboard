# Dockerfile.golang-cgo - A reusable, multi-stage Dockerfile for Go services needing CGO.

# --- Builder Stage ---
ARG GO_VERSION=1.21
FROM golang:${GO_VERSION}-alpine AS builder

# Install build tools and ZMQ library
RUN apk add --no-cache build-base zeromq-dev

# Set build argument for the service name
ARG SERVICE_NAME
WORKDIR /app

# Copy all module and workspace files to resolve dependencies and leverage caching.
COPY go.work ./
COPY libs/ ./libs/
COPY services/ ./services/

# Download dependencies. This step is now cacheable as long as go.work.sum doesn't change.
RUN go mod download

# Build the binary
RUN CGO_ENABLED=1 GOOS=linux go build -o /app/main ./services/${SERVICE_NAME}/cmd

# --- Final Stage ---
FROM alpine:latest

# Copy ZMQ runtime library from builder
COPY --from=builder /usr/lib/libzmq.so.5 /usr/lib/
WORKDIR /app
COPY --from=builder /app/main .
CMD ["./main"]