# Copy this file to .env and fill with local/private values.
# Never commit .env.

# Execution Gateway / XTS Interactive
XTS_API_KEY=
XTS_API_SECRET=
XTS_SOURCE=WEBAPI

# XTS Market Data
XTS_MD_API_KEY=
XTS_MD_API_SECRET=
XTS_API_KEY_M=
XTS_API_SECRET_M=
XTS_USER_ID=
XTS_CLIENT_ID=
XTS_PASSWORD=
XTS_API_BASE_URL=https://developers.symphonyfintech.in/

# Greeksoft
GREEK_API_AUTH_URL=http://greekapi.greeksoft.in:3001
GREEK_API_REST_URL=http://restapi.greeksoft.in:3434
GREEK_USERNAME=
GREEK_PASSWORD=
GREEK_CLIENT_ID=
GREEK_BROKER_ID=
GREEK_VALID_FOR=30d
GREEK_PAN_DOB=
GREEK_JLOGIN_PASSWORD=

# Postgres
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/trading?sslmode=disable

# Services
CONTROL_API_PORT=:8005
SNAPSHOT_SERVICE_PORT=8003
CONTRACT_MASTER_PORT=8010
UI_PORT=3000

# CSV paths
INDEX_TOKENS_PATH=/mnt/shared/IndexTokens.csv
BSE_INDEX_TOKENS_PATH=/mnt/shared/BSEIndexTokens.csv
INDEX_TOKENS_CSV=/mnt/shared/IndexTokens.csv
BSE_INDEX_TOKENS_CSV=/mnt/shared/BSEIndexTokens.csv
