# Environment variables for the trading-platform.
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit the .env file to version control.

# PostgreSQL Database
POSTGRES_HOST=db
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=trading_platform_db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Service Ports
CONTROL_API_PORT=8000
SNAPSHOT_SERVICE_PORT=8003
UI_PORT=3000

# Event Bus
NATS_URL=nats://nats:4222

# Broker Credentials
BROKER_USERNAME=YOUR_USERNAME
BROKER_PASSWORD=YOUR_PASSWORD

# Broker API URLs for Proxy
GREEK_API_AUTH_URL=http://greekapi.greeksoft.in:3001
GREEK_API_REST_URL=http://restapi.greeksoft.in:3434