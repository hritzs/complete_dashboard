	"execution-gateway/internal/trading"
)

type Executor struct {
	BaseURL  string
	Token    string
	ClientID string
	HTTP     *http.Client
	sem      chan struct{}
}

// NewExecutor creates a rate-limited XTS executor
func NewExecutor(baseURL, token, clientID string) *Executor {
	return &Executor{
		BaseURL:  baseURL,
		Token:    token,
		ClientID: clientID,
		HTTP:     &http.Client{Timeout: 5 * time.Second},
		sem:      make(chan struct{}, 4), // Throttle to 4 concurrent requests to prevent HTTP 429
	}
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func (e *Executor) ExecuteBatch(ctx context.Context, orders []trading.Order, batchUID string) (trading.ExecuteResult, error) {
	var result trading.ExecuteResult
	var mu sync.Mutex
	var wg sync.WaitGroup

	for _, order := range orders {
		wg.Add(1)
		go func(o trading.Order) {
			defer wg.Done()

			e.sem <- struct{}{}               // Acquire token
			defer func() { <-e.sem }()        // Release token
			time.Sleep(50 * time.Millisecond) // Pacing to prevent 429 limit

			log.Printf("[XTS] Placing Order -> Token: %d, Action: %s, Qty: %d, Limit: %.2f", o.Token, o.Action, o.Quantity, o.LimitPrice)

			payload := map[string]interface{}{
				"exchangeSegment":       "NSEFO", // Convert integer segment to string code if needed
				"exchangeInstrumentID":  o.Token,
				"productType":           "MIS",
				"orderType":             "LIMIT",
				"orderSide":             o.Action,
				"timeInForce":           "DAY",
				"disclosedQuantity":     0,
				"orderQuantity":         o.Quantity,
				"limitPrice":            o.LimitPrice,
				"stopPrice":             0.0,
				"orderUniqueIdentifier": o.UID[:min(len(o.UID), 20)], // XTS max is 20 chars
				"clientID":              e.ClientID,
			}

			bodyBytes, _ := json.Marshal(payload)
			req, _ := http.NewRequestWithContext(ctx, http.MethodPost, e.BaseURL+"/interactive/orders", bytes.NewBuffer(bodyBytes))
			req.Header.Set("Authorization", e.Token)
			req.Header.Set("Content-Type", "application/json")

			resp, err := e.HTTP.Do(req)

			mu.Lock()
			defer mu.Unlock()

			if err != nil {
				log.Printf("❌ XTS Place Error: %v", err)
				result.FailedOrders = append(result.FailedOrders, trading.FailedOrder{UID: o.UID, Status: "REJECTED", Reason: err.Error()})
				return
			}
			defer resp.Body.Close()

			var xtsResp map[string]interface{}
			json.NewDecoder(resp.Body).Decode(&xtsResp)

			if xtsResp["type"] != "success" {
				desc := fmt.Sprintf("%v", xtsResp["description"])
				log.Printf("❌ XTS Rejected Order: %s", desc)
				result.FailedOrders = append(result.FailedOrders, trading.FailedOrder{UID: o.UID, Status: "REJECTED", Reason: desc})
				return
			}

			resData := xtsResp["result"].(map[string]interface{})
			appOrderID := fmt.Sprintf("%v", resData["AppOrderID"])

			result.SuccessfulOrders = append(result.SuccessfulOrders, trading.PlacedOrder{
				AppOrderID: appOrderID,
				UID:        o.UID,
				Token:      o.Token,
				Action:     o.Action,
				Quantity:   o.Quantity,
			})
		}(order)
	}

	wg.Wait()
	return result, nil
}

func (e *Executor) VerifyOrdersBulk(ctx context.Context, orderIDs []string, verifyUID string) (trading.VerifyResult, error) {
	var result trading.VerifyResult

	req, _ := http.NewRequestWithContext(ctx, http.MethodGet, e.BaseURL+"/interactive/orders?clientID="+e.ClientID, nil)
	req.Header.Set("Authorization", e.Token)

	resp, err := e.HTTP.Do(req)
	if err != nil {
		return result, err
	}
	defer resp.Body.Close()

	var bookResp struct {
		Type   string                   `json:"type"`
		Result []map[string]interface{} `json:"result"`
	}
	if err := json.NewDecoder(resp.Body).Decode(&bookResp); err != nil {
		return result, err
	}

	orderMap := make(map[string]map[string]interface{})
	for _, o := range bookResp.Result {
		orderMap[fmt.Sprintf("%v", o["AppOrderID"])] = o
	}

	pendingIDs := make(map[string]bool)
	for _, id := range orderIDs {
		pendingIDs[id] = true
	}

	for id := range pendingIDs {
		bOrder, exists := orderMap[id]
		if !exists {
			continue
		}

		xtsStatus := fmt.Sprintf("%v", bOrder["OrderStatus"])
		uid := fmt.Sprintf("%v", bOrder["OrderUniqueIdentifier"])

		switch xtsStatus {
		case "FILLED", "COMPLETE", "TRADED", "EXECUTED":
			result.VerifiedSuccess = append(result.VerifiedSuccess, trading.VerifiedOrder{
				AppOrderID: id,
				UID:        uid,
				Status:     xtsStatus,
				FilledQty:  int(bOrder["CumulativeQuantity"].(float64)),
				AvgPrice:   bOrder["OrderAverageTradedPrice"].(float64),
			})
		case "REJECTED", "CANCELLED", "CANCELED":
			result.VerifiedFailed = append(result.VerifiedFailed, trading.FailedOrder{
				AppOrderID: id,
				UID:        uid,
				Status:     xtsStatus,
				Reason:     fmt.Sprintf("%v", bOrder["CancelRejectReason"]),
			})
		case "OPEN", "NEW", "REPLACED":
			// Send cancel request here...
			reqDel, _ := http.NewRequestWithContext(ctx, http.MethodDelete, fmt.Sprintf("%s/interactive/orders?appOrderID=%s&orderUniqueIdentifier=%s&clientID=%s", e.BaseURL, id, uid, e.ClientID), nil)
			reqDel.Header.Set("Authorization", e.Token)
			e.HTTP.Do(reqDel) // Fire and forget cancel

			result.VerifiedFailed = append(result.VerifiedFailed, trading.FailedOrder{
				AppOrderID: id,
				UID:        uid,
				Status:     "REEXECUTE_NEEDED",
				Reason:     "Stale limit order cancelled for chase",
			})
		}
	}

	return result, nil
}

