						stillPending = append(stillPending, id)
					}
				}
				unverifiedOrderIDs = stillPending

				if len(unverifiedOrderIDs) > 0 {
					log.Printf("⚠️ %d orders still pending in BUILD chunk %d. Retrying verification in 500ms...", len(unverifiedOrderIDs), chunkIdx+1)
					time.Sleep(500 * time.Millisecond)
				}
			}

			// 3. Process orders that need re-execution (e.g., stale limit orders that were cancelled)
			var ordersToRetryNow []Order
