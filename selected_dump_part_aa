		WebsocketSessionID: loginResp.Response.SessionID,
		IrisEndpoint:       fmt.Sprintf("%s:%d", data.IrisIP, data.IrisPort),
		ApolloEndpoint:     fmt.Sprintf("%s:%d", data.ApolloIP, data.ApolloPort),
