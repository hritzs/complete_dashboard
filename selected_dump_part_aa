	}
	if err := json.NewDecoder(res.Body).Decode(&body); err != nil {
		return 0, err
	}
	if !body.Success || body.LotSize <= 0 {
		if body.Error == "" {
			body.Error = "invalid lot size response"
		}
		return 0, fmt.Errorf(body.Error)
	}
	return body.LotSize, nil
